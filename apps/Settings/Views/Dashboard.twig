<div class="text-primary my-8 text-center text-[3em]">
  {{ translate('Settings') }}
</div>

<div class="flex-dyn p-2 m-auto w-1/2">
  <div class="card grow">
    <div class="card-header">{{ translate('About me') }}</div>
    <div class="card-body flex flex-col gap-2">
      <div class="mb-2">
        {{ user.first_name }}
        {{ user.last_name }}
        {{ user.email }}
        {{ user.nick }}
      </div>
    </div>
  </div>
  <a class="btn btn-square btn-primary-outline" href="settings/about-me">
    <span class="icon"><i class="fas fa-pencil"></i></span>
    <span class="text">{{ translate('Update my profile') }}</span>
  </a>
  <a class="btn btn-square btn-primary-outline" href="settings/update-password">
    <span class="icon"><i class="fas fa-shield"></i></span>
    <span class="text">{{ translate('Change password') }}</span>
  </a>
</div>
<div class="flex-dyn p-2 m-auto w-1/2">
  <div class="card grow">
    <div class="card-header">{{ translate('Users, apps and account') }}</div>
    <div class="card-body gap-2">
      <a class="btn btn-primary-outline w-full" href="settings/users">
        <span class="icon"><i class="fas fa-users"></i></span>
        <span class="text">{{ translate('Users') }}</span>
      </a>
      <a class="btn btn-primary-outline w-full mt-2" href="settings/apps">
        <span class="icon"><i class="fas fa-puzzle-piece"></i></span>
        <span class="text">{{ translate('Apps') }}</span>
      </a>
      {% if hubleto.appManager().isAppInstalled('Hubleto\\App\\Enterprise\\Cloud') %}
        <a class="btn btn-primary-outline w-full mt-2" href="{{ config.projectUrl }}/cloud">
          <span class="icon"><i class='fas fa-cloud'></i></span>
          <span class="text">{{ translate('Account') }}</span>
        </a>
      {% endif %}
    </div>
  </div>
  <div class="card grow">
    <div class="card-header">{{ translate('Theme') }}</div>
    <div class="card-body flex-dyn gap-2">
      {% for theme in viewParams.themes %}
        <a href="?setTheme={{ theme }}" class="btn {{ theme == viewParams.uiTheme ? "btn-primary" : "btn-transparent" }}">
          <span class="text">{{ theme }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

<div class="flex-dyn p-2 m-auto w-1/2">
  <div class="card grow">
    <div class="card-header">
      {{ translate('Localization') }}
    </div>
    <div class="card-body">
      <table class="table-default dense">
        <tbody>
          <tr>
            <td>{{ translate('Default currency') }}</td>
            <td>
              <div class="badge badge-info">{{ hubleto.locale().getCurrencyIsoCode() }} [{{ hubleto.locale().getCurrencySymbol() }}]</div>
            </td>
          </tr>
          <tr>
            <td>{{ translate('Timezone') }}</td>
            <td>
              <div class="badge badge-info">{{ hubleto.locale().getTimezone() }}</div>
            </td>
          </tr>
          <tr>
            <td>{{ translate('Date (short / long) and time formats') }}</td>
            <td class="flex gap-2">
              <div class="badge badge-info">{{ hubleto.locale().getDateShortFormat() }}</div>
              <div class="badge badge-info">{{ hubleto.locale().getDateLongFormat() }}</div>
              <div class="badge badge-info">{{ hubleto.locale().getTimeFormat() }}</div>
              <div class="badge badge-info">{{ hubleto.locale().getDatetimeFormat() }}</div>
            </td>
          </tr>
          <tr>
            <td>{{ translate('Decimals and thousands separator') }}</td>
            <td>
              <div class="badge badge-info">{{ hubleto.locale().getDecimalsSeparator() }}</div>
              <div class="badge badge-info">{{ hubleto.locale().getThousandsSeparator() }}</div>
            </td>
          </tr>
        </tbody>
      </table>
      <a class="btn btn-transparent mt-2" href="settings/localization">
        <span class="icon"><i class="fas fa-pencil"></i></span>
        <span class="text">{{ translate("Change localization settings") }}</span>
      </a>
    </div>
  </div>
</div>


<script>
  function searchSetting(q) {
    if (q == '') {
      $("#setting-buttons .btn").show();
    } else {
      $("#setting-buttons .btn").hide();
      const regex = new RegExp(q, "i");
      $("#setting-buttons .btn").each(function() {
        if ($(this).find('.text').text().match(regex)) {
          $(this).show();
        }
      });
      {# const found = paragraph.match(regex); #}
    }
  }
</script>

<div class="flex-dyn p-2 m-auto w-1/2">
  <div class="card">
    <div class="card-header">{{ translate('All settings') }}</div>
    <div class="card-body">
      <input
        class="w-full p-2 border border-gray text-lg"
        placeholder="{{ translate('Search settings...') }}"
        onkeyup="searchSetting(this.value);"
      />

      <div id="setting-buttons" class="mt-4 flex flex-wrap gap-2">
        {% for setting in viewParams.settings %}
          <a class="btn btn-transparent w-60" href="{{ setting.url }}">
            <span class="icon"><i class="{{ setting.icon }}"></i></span>
            <span class="text">{{ setting.title }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="mt-8 text-right p-2">
  <a href="{{ config.projectUrl }}/?sign-out" class="btn btn-transparent">
    <span class="icon"><i class="fas fa-sign-out"></i></span>
    <span class="text">{{ translate("Sign out from Hubleto") }}</span>
  </a>
</div>