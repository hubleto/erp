<h1 class="app-main-title">{{ viewParams.title }}</h1>

<nav class="flex flex-wrap gap-2 mb-3" aria-label="{{ translate('Performance and development') }}">
  <a class="btn btn-transparent" href="hr-performance/goals">{{ translate('Goals') }}</a>
  <a class="btn btn-transparent" href="hr-performance/reviews">{{ translate('Reviews') }}</a>
  <a class="btn btn-transparent" href="hr-performance/courses">{{ translate('Courses') }}</a>
  <a class="btn btn-transparent" href="hr-performance/learning">{{ translate('Learning assignments') }}</a>
</nav>

<hblreact-hrperformance-table
  string:tag="hr-performance"
  string:model="{{ viewParams.model }}"
  string:base-url-slug="{{ viewParams.baseUrlSlug }}"
  int:record-id="{{ viewParams.recordId }}"
  string:fulltext-search="{{ viewParams.q }}"
  json:column-search="{{ viewParams.search|json_encode }}"
  json:filters="{{ viewParams.filters|json_encode }}"
  string:form-active-tab-uid="{{ viewParams.tab }}"
></hblreact-hrperformance-table>