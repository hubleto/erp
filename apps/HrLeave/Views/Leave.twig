<h1 class="app-main-title">{{ viewParams.title }}</h1>

<nav class="flex flex-wrap gap-2 mb-3" aria-label="{{ translate('Leave management') }}">
  <a class="btn btn-transparent" href="hr-leave/requests">{{ translate('Requests') }}</a>
  <a class="btn btn-transparent" href="hr-leave/types">{{ translate('Leave types') }}</a>
  <a class="btn btn-transparent" href="hr-leave/balances">{{ translate('Entitlements') }}</a>
</nav>

<hblreact-hrleave-table
  string:tag="hr-leave"
  string:model="{{ viewParams.model }}"
  string:base-url-slug="{{ viewParams.baseUrlSlug }}"
  int:record-id="{{ viewParams.recordId }}"
  string:fulltext-search="{{ viewParams.q }}"
  json:column-search="{{ viewParams.search|json_encode }}"
  json:filters="{{ viewParams.filters|json_encode }}"
  string:form-active-tab-uid="{{ viewParams.tab }}"
></hblreact-hrleave-table>