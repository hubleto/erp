<h1 class='app-main-title'>{{ translate('Settings') }} > {{ translate('Update password') }}</h1>

<div class="sign-in-screen">
  <div class="inner">
    <div class="form">
      <form class="content min-w-min" id="update_password_form" action="" method="POST">
        <input type="hidden" name="submitted" value="1">

        <div class="text-2xl text-primary text-center pt-8 pb-4">{{ config.accountFullName }}</div>

        {% if viewParams.submitted and  viewParams.status %}
          <div class="alert alert-success mb-2">{{ translate("Password successfully updated.") }}</div>
        {% else %}
          {% if viewParams.errors|length > 0 %}
            <div class="alert alert-danger mb-2">{{ viewParams.errors|join('<br/>') }}</div>
          {% endif %}

          <input
            type="password" name="password_1" placeholder="{{ translate("New password") }}"
            onkeypress='if (event.keyCode == 13) { document.getElementById("update_password_form").submit(); }'
          />
          <input
            type="password" name="password_2" placeholder="{{ translate("Confirm new password") }}"
            onkeypress='if (event.keyCode == 13) { document.getElementById("update_password_form").submit(); }'
          />

          <div class="gap-2 flex justify-between items-center mt-8">
            <button type="submit" class="btn btn-large mt-4">
              <span class="icon"><i class="fas fa-arrow-right"></i></span>
              <span class="text">{{ translate("Update password") }}</span>
            </button>
          </div>
        {% endif %}

      </form>
    </div>
  </div>
</div>