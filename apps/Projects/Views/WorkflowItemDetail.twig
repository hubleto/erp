{% set openMilestones = 0 %}
{% for m in item.MILESTONES %} {% if not m.is_closed %} {% set openMilestones = openMilestones + 1 %} {% endif %} {% endfor %}

<div class="p-2 text-sm font-normal">
  <div class="flex justify-between w-full">
    <div class="flex flex-col truncate gap-1">
      <div class="flex flex-row gap-2">
        <div class="text-primary">{{ item.PROJECT_MANAGER.nick }}</div>
        <div class="text-gray-400">{{ item.CUSTOMER.name }}</div>
      </div>
      <div class="font-bold">{{ item.identifier }} {{ item.title }}</div>
      {% if openMilestones <= 0 %}
        <div>{{ translate('Project has no open milestones.') }}</div>
      {% else %}
        <div class="list dense">
          {% for m in item.MILESTONES %}
            {% if not m.is_closed %} 
              <a
                class="btn btn-list-item btn-transparent {{ (m.REPORTS|first).progress_percent == 100 ? "text-gray-600" : "text-violet-600" }}"
                href="{{ hubleto.env().projectUrl }}/projects/milestones/{{ m.id }}"
                target="_blank"
              >
                <span class="icon"><i class="fas fa-calendar-check"></i></span>
                <span class="text block">
                  <div>
                    <span style="{% if date(m.date_due) < date() %} color:red; {% endif %}">
                      {{ hubleto.locale().formatDateShort(m.date_due) }}
                    </span>
                    {{ m.title }}
                  </div>
                  <div class="text-gray-800">
                    {% if m.REPORTS|length > 0 %}
                      <progress max="100" value="{{ (m.REPORTS|first).progress_percent }}" class="w-12"></progress>
                      {{ translate('{{ progress }} % on {{ date }}', { progress: (m.REPORTS|first).progress_percent, date: hubleto.locale().formatDateShort((m.REPORTS|first).date_report) }) }},
                      {{ (m.REPORTS|first).summary }}
                    {% else %}
                      ({{ translate('no report yet') }})
                    {% endif %}
                  </div>
                </span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
      {% for t in item.TASKS %}
        {% if t.TASK.identifier > 0 %}
          <div class="text-sm">
            <a class="text-primary" href="{{ config.projectUrl }}/tasks/{{ t.TASK.id }}" target="_blank">
              <span class="badge badge-primary">{{ t.TASK.identifier }}</span>
              <b>{{ t.TASK.title }}</b>
            </a>
            {% if t.TASK.TODO|length > 0 %}
              <ul class="text-sm ml-12 list-decimal">
                {% for td in t.TASK.TODO %}
                  {% if not td.is_closed %}
                    <li>
                      <span class="text-primary">{{ td.RESPONSIBLE.nick }}</span>
                      {{ td.todo }}
                      <span style="{% if date(td.date_deadline) < date() %} color:red; {% endif %}">
                        {{ hubleto.locale().formatDateShort(td.date_deadline) }}
                      </span>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
