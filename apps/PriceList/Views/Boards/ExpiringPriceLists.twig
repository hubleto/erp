<div class="flex flex-col gap-2 items-center">
  <div class="text-[3em] p-4 text-primary">{{ viewParams.total }}</div>
  <div class="text-sm">{{ translate('price lists are about to expire') }}</div>
</div>
{% if viewParams.items|length > 0 %}
  <div class="list mt-2">
    {% for item in viewParams.items %}
      <a href="price-lists/{{ item.id }}" class="btn btn-list-item btn-transparent flex-col items-start md:flex-row" target="_blank">
        <span class="text max-h-none">
          <b>{{ item.code }}</b>
          {{ item.name }}
          <div class="badge badge-small badge-orange">{{ translate('valid to') }} {{ item.valid_to }}</div>
        </span>
      </a>
    {% endfor %}
  </div>
{% endif %}
