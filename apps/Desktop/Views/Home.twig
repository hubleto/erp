{% set defaultDashboard = viewParams.defaultDashboard %}
{% set welcomeSplashImageUrl = config.welcomeSplashImageUrl ?? hubleto.env().assetsUrl ~ "/images/logo-hubleto-text-horizontal.png" %}

<div class="block md:hidden grid grid-cols-3 gap-0 m-2">
  {% for app in viewParams.appsInSidebar %}
    <a
      class="btn btn-small btn-transparent rounded-none border-none"
      href="{{ config.projectUrl }}/{{ app.manifest.rootUrlSlug }}" data-pr-tooltip="{{ app.manifest.nameTranslated }}"
      title="{{ app.manifest.nameTranslated }}"
    >
      <span class="icon"><i class="{{ app.manifest.icon }}"></i></span>
      <span class="text">{{ app.manifest.nameTranslated }}</span>
    </a>
  {% endfor %}
</div>

<div class="w-full h-full flex-dyn">
  <div class="grow">
    <div class="text-primary my-8 text-center text-[3em]">
      {{ translate('Welcome') }}, {{ user.first_name ?? user.email }}
    </div>

    {% for m in viewParams.welcomeScreenMessages %}
      <div class="alert alert-{{ m.class }} mx-auto my-8 max-w-[90vw] md:max-w-[50vw]">
        {% if m.icon %}
          <div class="icon"><i class="{{ m.icon }}"></i></div>
        {% endif %}
        <div class='grow'>
          {% if m.title %}<p><b>{{ m.title|raw }}</b></p>{% endif %}
          {{ m.content|raw }}
        </div>
        {% if m.button %}
          <div>{{ m.button|raw }}</div>
        {% endif %}
      </div>
    {% endfor %}

    <div class="mt-2 mx-auto my-8 max-w-[90vw] md:max-w-[50vw]">
      <hblreact-dashboards-dashboard
        int:id-dashboard='{{ defaultDashboard.id }}'
        string:redirect-url='{{ config.projectUrl }}'
        json:panels='{{ defaultDashboard.PANELS|json_encode|raw }}'
        bool:show-add-new-panel-button='true'
      ></hblreact-dashboards-dashboard>
    </div>
  </div>

  <div class="flex flex-col gap-2 border-l border-l-gray-200 h-full">
    <div class="m-2">
      <div class="text-primary flex-col w-60 bg-primary/10 p-2">
        <div class='mb-2'>
          <b>Did you know?</b><br>
          {{ viewParams.didYouKnow|raw }}
        </div>
        <div>
          <a href="https://help.hubleto.eu" target="_blank" class="btn btn-white">
            <span class="icon"><i class="fas fa-book"></i></span>
            <span class="text">Open user guide</span>
          </a>  
        </div>
      </div>
    </div>

    <div class="grow p-2 mb-2 flex flex-col md:flex-row gap-2">
      <div class="m-8 dark:text-white">
        <div class="flex">
          {% if user.photo %}
            <div class="mr-8">
              <img
                src="{{ config.uploadUrl }}/{{ user.photo }}"
                class='max-w-48 max-h-24 rounded-4xl'
              />
            </div>
          {% endif %}
          <div>
            <div>
              <b>{{ user.first_name }} {{ user.last_name }}</b>
              <a href="settings/my-account" class="btn btn-transparent">
                <span class="icon"><i class="fas fa-pencil"></i></span>
              </a>
            </div>
            <div><b>{{ user.DEFAULT_COMPANY.name }}</b></div>
            {% if user.position %} <div class="badge">{{ user.position }}</div> {% endif %}
            <div class="mt-2">{{ user.email }}</div>
          </div>
        </div>
      </div>
      {% if user.DEFAULT_COMPANY.logo != '' %}
        <div class="flex items-center">
          <img
            src="{{ config.uploadUrl }}/{{ user.DEFAULT_COMPANY.logo }}"
            class="max-h-32 max-w-32 m-8"
          />
        </div>
      {% endif %}
    </div>

    <div>
      <img src="{{ welcomeSplashImageUrl }}" class="w-48 m-4 mx-auto">
    </div>

    {% if hubleto.appManager().isAppInstalled('Hubleto\\App\\Community\\Usage') %}
      {% set recentlyUsed = hubleto.getService('Hubleto\\App\\Community\\Usage\\Logger').getRecentlyUsedAppNamespaces() %}
      {% if recentlyUsed|length > 0 %}
        <div class="mb-2 hidden m:block dark:text-gray-200">
          <div><small>{{ translate('Recently used apps') }}</small></div>
          <div class="list">
            {% for appNamespace in recentlyUsed %}
              {% set manifest = hubleto.appManager().getApp(appNamespace).manifest %}
              <a href="{{ manifest.rootUrlSlug }}" class="btn btn-list-item btn-transparent">
                <span class="icon"><i class="{{ manifest.icon }}"></i></span>
                <span class="text">{{ manifest.nameTranslated }}</span>
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>