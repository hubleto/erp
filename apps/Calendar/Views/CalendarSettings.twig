<div class="flex">
  <h1 class="app-main-title">{{ translate('Calendar') }} > {{ translate('Settings') }}</h1>
  {% if viewParams.settingsSaved %}
    <div id="settings-saved-message" class="badge badge-info text-sm ml-4">{{ translate('Settings saved.') }}</div>
  {% endif %}
</div>

<script>
  function saveSettings() {
    $("#settings-form").submit();
  }

  setTimeout(function () {
    $("#settings-saved-message").fadeOut();
  }, 3000);
</script>

<div class="card mt-10 w-1/2 m-auto">
  <div class="card-header">{{ translate('Users who can view calendars and activities of other users') }}</div>
  <form id="settings-form" action="" method="POST">
    <input type="hidden" name="settingsChanged" value="1">
    <table class="table-default">
      <tbody>
        {% for user in viewParams.users %}
          <tr>
            <td>
              <input
                type="checkbox"
                name="usersPermittedToViewOtherCalendars[]"
                value="{{ user.id }}"
                {% if user.id in viewParams.usersPermittedToViewOtherCalendars %}checked{% endif %}
                onchange="saveSettings();"
              />
            </td>
            <td>{{ user.first_name }} {{ user.last_name }}</td>
            <td>{{ user.email }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </form>
</div>
